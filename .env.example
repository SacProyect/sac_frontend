# API backend. En local apunta al backend en PORT (default 3000).
VITE_BASE_URL=http://localhost:3000

# Opcional: URL alternativa / sockets (si no se define, se usa VITE_BASE_URL)
# VITE_API_URL=http://localhost:3000
# VITE_SOCKET_URL=http://localhost:3000
# VITE_BASE_URL_VISITS=http://localhost:3000

# Feature flags
VITE_NOTIFICATIONS_ENABLED=false
VITE_INTERNAL_AUDIT_ENABLED=false
VITE_TAXPAYER_DASHBOARD_ENABLED=true
VITE_THEME_TOGGLE_ENABLED=true
VITE_VISIT_NOTIFICATIONS_ENABLED=true
VITE_MAQUINAS_FISCALES_ENABLED=true
VITE_CONTROLES_INGRESO_ENABLED=true
VITE_WHATSAPP_NOTIFICATIONS_ENABLED=false

# Habilita la nueva página /gestion-actas (Command Center UI renovado).
# Default: false. Activar solo tras merge de TASK-006b y validación en staging.
VITE_ACTAS_EXPEDIENTES_ENABLED=false

# Auth fake solo en `vite` dev
# VITE_DEV_FAKE_AUTH=true

# Mapa de parroquias (pin de ubicación)
# VITE_PARISH_PIN_MAP_ENABLED=true

# Modo mantenimiento global. Cuando está en true, solo usuarios ADMIN pueden usar la app.
# VITE_MAINTENANCE_MODE_ENABLED=true
# VITE_MAINTENANCE_TITLE=Sitio en mantenimiento
# VITE_MAINTENANCE_MESSAGE=Estamos realizando actualizaciones. Vuelve pronto.
